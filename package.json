{
  "name": "sully-api-demo",
  "version": "0.1.0",
  "description": "Demo code and apps for how to use the Sully.ai public API",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm build:client && pnpm build:server",
    "build:client": "esbuild browser/playground-app.ts --bundle --outfile=dist/demo-app.js --platform=browser --target=es2021 --format=esm",
    "build:server": "tsc -p tsconfig.server.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.browser.json --noEmit",
    "test:unit": "tsx --test __tests__/*.test.ts",
    "test": "pnpm test:unit",
    "test:e2e": "pnpm build && playwright test",
    "start": "pnpm build && node dist/server.js",
    "start:note": "tsx sully-demo.ts note",
    "start:stream": "tsx sully-demo.ts stream"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@speechmatics/browser-audio-input": "^2.0.3",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "form-data": "^4.0.1",
    "multer": "^2.2.0",
    "node-fetch": "^3.3.2",
    "node-microphone": "^0.1.6",
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@types/express": "^4.17.25",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.9.0",
    "@types/node-microphone": "^0.1.4",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.27.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
